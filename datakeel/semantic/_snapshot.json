  "invariants": {
    "aliasCycleCheck": true,
    "conflictingRolePolicy": "ambiguous",
    "everyFormatHasDefaultModality": true,
    "samePriorityConflictIsSchemaError": true,
    "uniqueCodes": true,
    "uniqueExtensions": true,
    "unknownExtensionPolicy": "unknown"
  },
  "normalization": {
    "case": "lower",
    "mimeConflictPolicy": "ambiguous",
    "rawFileTypePolicy": "distrust",
    "stripLeadingDot": true,
    "suffixStrategy": "longest-match"
  },
  "roleRules": [
    {
      "id": "role.standard.v1",
      "priority": 500,
      "then": {
        "confidence": 1.0,
        "usageRole": "fromStandard"
      },
      "when": {
        "standardRole": "*"
      }
    },
    {
      "id": "role.manifest.explicit.v1",
      "priority": 400,
      "then": {
        "confidence": 1.0,
        "usageRole": "fromManifest"
      },
      "when": {
        "manifestRole": "*"
      }
    },
    {
      "id": "role.metadata.explicit-manifest.v1",
      "priority": 350,
      "then": {
        "confidence": 1.0,
        "usageRole": "metadata"
      },
      "when": {
        "parentRelationAny": [
          "manifest-for-archive"
        ]
      }
    },
    {
      "id": "role.preview.path.v1",
      "priority": 300,
      "then": {
        "confidence": 1.0,
        "usageRole": "preview"
      },
      "when": {
        "pathPrefixAny": [
          "_preview/",
          "_previews/"
        ]
      }
    },
    {
      "id": "role.artifact.path.processed.v1",
      "priority": 300,
      "then": {
        "confidence": 1.0,
        "usageRole": "artifact"
      },
      "when": {
        "pathPrefixAny": [
          "processed/"
        ]
      }
    },
    {
      "id": "role.metadata.camera-config-path.v1",
      "priority": 300,
      "then": {
        "confidence": 0.85,
        "usageRole": "metadata"
      },
      "when": {
        "pathSegmentsAny": [
          "camera_config"
        ]
      }
    },
    {
      "id": "role.annotation.path.v1",
      "priority": 300,
      "then": {
        "confidence": 0.75,
        "usageRole": "annotation"
      },
      "when": {
        "pathSegmentsAny": [
          "annotations",
          "labels"
        ]
      }
    },
    {
      "id": "role.readme.filename.v1",
      "priority": 200,
      "then": {
        "confidence": 1.0,
        "usageRole": "readme"
      },
      "when": {
        "fileNameRegex": "(?i)^readme(\\..*)?$"
      }
    },
    {
      "id": "role.manifest.filename.v1",
      "priority": 200,
      "then": {
        "confidence": 0.6,
        "usageRole": "metadata"
      },
      "when": {
        "fileNameRegex": "(?i)^manifest\\.json$",
        "pathDepthMax": 2
      }
    },
    {
      "id": "role.artifact.suffix.result.v1",
      "priority": 200,
      "then": {
        "confidence": 1.0,
        "usageRole": "artifact"
      },
      "when": {
        "fileNameSuffixAny": [
          "_result.json"
        ]
      }
    },
    {
      "id": "role.artifact.suffix.annotation.v1",
      "priority": 200,
      "then": {
        "confidence": 1.0,
        "usageRole": "artifact"
      },
      "when": {
        "fileNameSuffixAny": [
          "_annotation.json"
        ]
      }
    },
    {
      "id": "role.payload.default.v1",
      "priority": 100,
      "then": {
        "confidence": 0.5,
        "usageRole": "payload"
      },
      "when": {
        "datasetTypesNotAny": [
          "text"
        ],
        "formatCodesAny": [
          "structured-json"
        ]
      }
    }
  ],
  "schemaVersion": 1,
  "vocabularies": {
    "admissionState": [
      "unknown",
      "accepted",
      "quarantined",
      "exempt",
      "rejected"
    ],
    "containerKind": [
      "none",
      "archive",
      "compression",
      "directory-image"
    ],
    "formatFamily": [
      "raster-image",
      "vector-image",
      "raw-pixel",
      "audio",
      "video",
      "point-cloud",
      "mesh-3d",
      "structured-text",
      "plain-text",
      "document",
