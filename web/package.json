{
  "name": "datakeel-web",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/write-notices.mjs && node scripts/write-aliases.mjs && node scripts/write-source-hash.mjs",
    "lint": "npm run check:api && npm run check:tokens && npm run check:contrast && npm run test:style-gates && eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "check:source": "node scripts/check-source.mjs",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "smoke:tour": "node scripts/demo-tour.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:style-gates": "node scripts/check-tokens.mjs --self-test && node scripts/check-contrast.mjs --self-test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "6.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
