{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datakeel.org/contracts/file-semantics.schema.json",
  "title": "File semantic contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "normalization",
    "vocabularies",
    "formats",
    "roleRules",
    "invariants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "stripLeadingDot",
        "suffixStrategy",
        "rawFileTypePolicy",
        "mimeConflictPolicy"
      ],
      "properties": {
        "case": {
          "const": "lower"
        },
        "stripLeadingDot": {
          "const": true
        },
        "suffixStrategy": {
          "const": "longest-match"
        },
        "rawFileTypePolicy": {
          "const": "distrust"
        },
        "mimeConflictPolicy": {
          "const": "ambiguous"
        }
      }
    },
    "vocabularies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "modality",
        "usageRole",
        "containerKind",
        "admissionState",
        "formatFamily",
        "toolCapability"
      ]
    },
    "formatAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "target"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "extensions",
          "formatFamily",
          "defaultModality",
          "containerKind"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "extensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.+-]*$"
            }
          },
          "mimeHints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "formatFamily": {
            "type": "string",
            "minLength": 1
          },
          "defaultModality": {
            "type": "string",
            "minLength": 1
          },
          "containerKind": {
            "type": "string",
            "minLength": 1
          },
          "ruleIdPattern": {
            "type": "string",
            "minLength": 1
          },
          "ruleIds": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "required": [
              "ruleIdPattern"
            ]
          },
          {
            "required": [
              "ruleIds"
            ]
          }
        ]
      }
    },
    "roleRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "when": {
            "type": "object",
            "minProperties": 1
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "usageRole",
              "confidence"
            ],
            "properties": {
              "usageRole": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknownExtensionPolicy",
        "conflictingRolePolicy",
        "uniqueCodes",
        "uniqueExtensions",
        "aliasCycleCheck",
        "everyFormatHasDefaultModality",
        "samePriorityConflictIsSchemaError"
      ],
      "properties": {
        "unknownExtensionPolicy": {
          "const": "unknown"
        },
        "conflictingRolePolicy": {
          "const": "ambiguous"
        },
        "uniqueCodes": {
          "const": true
        },
        "uniqueExtensions": {
          "const": true
        },
        "aliasCycleCheck": {
          "const": true
        },
        "everyFormatHasDefaultModality": {
          "const": true
        },
        "samePriorityConflictIsSchemaError": {
          "const": true
        }
      }
    }
  }
}
