  {
    "id": "audio.loudness",
    "modality": "audio",
    "category": "quality",
    "inputs": {
      "files": "files.audio"
    },
    "outputs": {
      "files": "files.audio"
    },
    "parameters": {
      "additionalProperties": false,
      "description": "Measure EBU R128 loudness and optionally create a normalized PCM artifact.\n\nIntegrated loudness inside ``[acceptable_min_lufs, acceptable_max_lufs]``, widened\nby ``loudness_tolerance_lu`` on both sides, is not flagged. The default range runs\nfrom the EBU R128 broadcast target (-23 LUFS) to the -14 LUFS normalization level\nof the loudest common streaming platforms, with R128's +/-1 LU tolerance; set the\nrange to -23..-23 for strict broadcast delivery (-23 +/- 1). ``target_lufs`` is the\nlevel that ``normalize`` produces.",
      "properties": {
        "normalize": {
          "default": false,
          "title": "Normalize",
          "type": "boolean"
        },
        "target_lufs": {
          "default": -23.0,
          "maximum": -5,
          "minimum": -70,
          "title": "Target Lufs",
          "type": "number"
        },
        "acceptable_min_lufs": {
          "default": -23.0,
          "maximum": -5,
          "minimum": -70,
          "title": "Acceptable Min Lufs",
          "type": "number"
        },
        "acceptable_max_lufs": {
          "default": -14.0,
          "maximum": -5,
          "minimum": -70,
          "title": "Acceptable Max Lufs",
          "type": "number"
        },
        "loudness_tolerance_lu": {
          "default": 1.0,
          "maximum": 30,
          "minimum": 0,
          "title": "Loudness Tolerance Lu",
          "type": "number"
        },
        "true_peak_dbfs": {
          "default": -1.0,
          "maximum": 0,
          "minimum": -9,
          "title": "True Peak Dbfs",
          "type": "number"
        },
        "loudness_range_lu": {
          "default": 7.0,
          "maximum": 50,
          "minimum": 1,
          "title": "Loudness Range Lu",
          "type": "number"
        }
      },
      "title": "LoudnessParams",
      "type": "object"
    },
    "queue": "cpu"
  },
  {
    "id": "audio.clipping",
    "modality": "audio",
    "category": "quality",
    "inputs": {
      "files": "files.audio"
    },
    "outputs": {
      "files": "files.audio"
    },
    "parameters": {
      "additionalProperties": false,
      "description": "Find full-scale plateaus and near-full-scale dwelling without downmixing channels.",
      "properties": {
        "threshold": {
          "default": 0.999,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Threshold",
          "type": "number"
        },
        "min_consecutive_samples": {
          "default": 3,
          "maximum": 10000,
          "minimum": 1,
          "title": "Min Consecutive Samples",
          "type": "integer"
        },
        "saturation_level": {
          "default": 0.85,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Saturation Level",
          "type": "number"
        },
        "saturation_occupancy": {
          "default": 0.45,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Saturation Occupancy",
          "type": "number"
        },
        "window_ms": {
          "default": 20,
          "maximum": 1000,
          "minimum": 1,
          "title": "Window Ms",
          "type": "integer"
        },
        "merge_gap_ms": {
          "default": 50,
          "maximum": 5000,
          "minimum": 0,
          "title": "Merge Gap Ms",
          "type": "integer"
        }
      },
      "title": "ClippingParams",
      "type": "object"
    },
    "queue": "cpu"
  },
  {
    "id": "audio.dedup",
    "modality": "audio",
    "category": "deduplication",
    "inputs": {
      "files": "files.audio"
    },
    "outputs": {
      "files": "files.audio"
    },
    "parameters": {
      "additionalProperties": false,
      "description": "Compare MFCC spectral shape and fluctuation time course within a duration tolerance.\n\nVarying sound is a copy when its MFCC fluctuations correlate within ``max_lag_ms``;\nsteady tones are compared by spectral shape alone.",
      "properties": {
        "correlation_threshold": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Correlation Threshold",
          "type": "number"
        },
        "shape_threshold": {
          "default": 0.75,
          "maximum": 1,
          "minimum": 0,
          "title": "Shape Threshold",
          "type": "number"
        },
        "stationary_threshold": {
          "default": 0.95,
          "maximum": 1,
          "minimum": 0,
          "title": "Stationary Threshold",
          "type": "number"
        },
        "max_lag_ms": {
          "default": 200,
          "maximum": 5000,
          "minimum": 0,
          "title": "Max Lag Ms",
          "type": "integer"
        },
        "duration_tolerance": {
          "default": 0.05,
          "maximum": 0.5,
          "minimum": 0,
          "title": "Duration Tolerance",
          "type": "number"
        },
        "remove": {
          "default": true,
          "title": "Remove",
          "type": "boolean"
        }
      },
      "title": "DedupParams",
      "type": "object"
    },
    "queue": "cpu"
  },
