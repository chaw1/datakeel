  {
    "id": "image.quality",
    "version": "1.0.0",
    "modality": "image",
    "category": "quality",
    "inputs": {
      "files": "files.image"
    },
    "outputs": {
      "files": "files.image"
    },
    "parameters": {
      "additionalProperties": false,
      "description": "Define image-quality thresholds in luminance, pixels and robust noise sigma.",
      "properties": {
        "blur_threshold": {
          "default": 50.0,
          "minimum": 0,
          "title": "Blur Threshold",
          "type": "number"
        },
        "min_brightness": {
          "default": 20.0,
          "maximum": 255,
          "minimum": 0,
          "title": "Min Brightness",
          "type": "number"
        },
        "max_brightness": {
          "default": 235.0,
          "maximum": 255,
          "minimum": 0,
          "title": "Max Brightness",
          "type": "number"
        },
        "min_resolution": {
          "default": 64,
          "minimum": 1,
          "title": "Min Resolution",
          "type": "integer"
        },
        "max_noise_sigma": {
          "default": 12.0,
          "exclusiveMinimum": 0,
          "maximum": 255,
          "title": "Max Noise Sigma",
          "type": "number"
        },
        "min_color_stddev": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "maximum": 128,
          "title": "Min Color Stddev",
          "type": "number"
        },
        "max_clipped_fraction": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Clipped Fraction",
          "type": "number"
        },
        "analysis_size": {
          "default": 512,
          "maximum": 2048,
          "minimum": 32,
          "title": "Analysis Size",
          "type": "integer"
        }
      },
      "title": "ImageQualityParams",
      "type": "object"
    },
    "queue": "cpu"
  },
