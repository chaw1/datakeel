  {
    "id": "video.invalid_frames",
    "modality": "video",
    "category": "quality",
    "inputs": {
      "files": "files.video"
    },
    "outputs": {
      "files": "files.video"
    },
    "parameters": {
      "additionalProperties": false,
      "description": "Configure signal thresholds at the documented 160 by 90 analysis scale.\n\n``sample_fps`` is the maximum analysis rate: slower video is examined frame by\nframe, so interval boundaries are exact to one frame.",
      "properties": {
        "sample_fps": {
          "default": 30.0,
          "maximum": 60,
          "minimum": 1,
          "title": "Sample Fps",
          "type": "number"
        },
        "black_threshold": {
          "default": 16.0,
          "maximum": 255,
          "minimum": 0,
          "title": "Black Threshold",
          "type": "number"
        },
        "solid_std_threshold": {
          "default": 2.0,
          "maximum": 128,
          "minimum": 0,
          "title": "Solid Std Threshold",
          "type": "number"
        },
        "freeze_difference": {
          "default": 0.75,
          "maximum": 255,
          "minimum": 0,
          "title": "Freeze Difference",
          "type": "number"
        },
        "freeze_local_difference": {
          "default": 2.0,
          "maximum": 255,
          "minimum": 0,
          "title": "Freeze Local Difference",
          "type": "number"
        },
        "freeze_locality": {
          "default": 10.0,
          "maximum": 1000,
          "minimum": 1,
          "title": "Freeze Locality",
          "type": "number"
        },
        "freeze_noise_ratio": {
          "default": 0.5,
          "maximum": 10,
          "minimum": 0,
          "title": "Freeze Noise Ratio",
          "type": "number"
        },
        "freeze_duration_ms": {
          "default": 1200,
          "minimum": 100,
          "title": "Freeze Duration Ms",
          "type": "integer"
        },
        "blur_variance_threshold": {
          "default": 8.0,
          "minimum": 0,
          "title": "Blur Variance Threshold",
          "type": "number"
        },
        "minimum_interval_ms": {
          "default": 200,
          "minimum": 0,
          "title": "Minimum Interval Ms",
          "type": "integer"
        },
        "remove": {
          "default": false,
          "title": "Remove",
          "type": "boolean"
        },
        "invalid_ratio_threshold": {
          "default": 0.99,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Invalid Ratio Threshold",
          "type": "number"
        }
      },
      "title": "InvalidFramesParams",
      "type": "object"
    },
    "queue": "cpu"
  },
  {
    "id": "video.dedup",
    "modality": "video",
    "category": "deduplication",
    "inputs": {
      "files": "files.video"
    },
    "outputs": {
      "files": "files.video"
    },
    "parameters": {
      "additionalProperties": false,
      "description": "Search repeated windows frame by frame and extend each match to its real extent.\n\nRepeats lasting at least 1.5 windows are located wherever they start. Frames\nmatch when the thumbnail differs little on average (``max_spatial_difference``)\nand nowhere by much (``max_local_difference``, so a changed clock digit or a\nsubject elsewhere in a static scene is not a match), and when the picture\nchanges the same way; windows of static picture are never reported.",
      "properties": {
        "window_ms": {
          "default": 2000,
          "maximum": 60000,
          "minimum": 500,
          "title": "Window Ms",
          "type": "integer"
        },
        "sample_fps": {
          "default": 30.0,
          "maximum": 60,
          "minimum": 1,
          "title": "Sample Fps",
          "type": "number"
        },
        "max_hamming": {
          "default": 6.0,
          "maximum": 32,
          "minimum": 0,
          "title": "Max Hamming",
          "type": "number"
        },
        "max_brightness_difference": {
          "default": 16.0,
          "maximum": 255,
          "minimum": 0,
          "title": "Max Brightness Difference",
          "type": "number"
        },
        "max_spatial_difference": {
          "default": 2.0,
          "maximum": 255,
          "minimum": 0,
          "title": "Max Spatial Difference",
          "type": "number"
        },
        "max_local_difference": {
          "default": 32.0,
          "maximum": 255,
          "minimum": 0,
          "title": "Max Local Difference",
          "type": "number"
        },
        "minimum_clip_ms": {
          "default": 250,
          "minimum": 0,
          "title": "Minimum Clip Ms",
          "type": "integer"
        },
        "remove": {
          "default": false,
          "title": "Remove",
          "type": "boolean"
        }
      },
      "title": "DedupParams",
      "type": "object"
    },
    "queue": "cpu"
  },
