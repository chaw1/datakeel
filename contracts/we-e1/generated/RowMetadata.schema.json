{
  "$defs": {
    "EvidenceFile": {
      "additionalProperties": false,
      "description": "Identify locally retained upstream evidence, never an invented assertion.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "EvidenceFile",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Normalize upstream metadata while retaining the hash-bound original response.",
  "properties": {
    "attribution": {
      "title": "Attribution",
      "type": "string"
    },
    "author": {
      "title": "Author",
      "type": "string"
    },
    "config": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
