[importlinter]
root_package = datakeel
include_external_packages = True

[importlinter:contract:application-layers]
name = Applications only depend on domain services and core
type = layers
layers =
    datakeel.cli
    datakeel.kg_eval | datakeel.extraction_runtime | datakeel.api | datakeel.worker | datakeel.agent | datakeel.runtime | datakeel.harness | datakeel.mcp
    datakeel.transcription | datakeel.kg | datakeel.pipeline | datakeel.quality | datakeel.lineage | datakeel.governance | datakeel.semantic | datakeel.operators | datakeel.storage | datakeel.http | datakeel.sample | datakeel.sample_kg | datakeel.sample_evidence | datakeel.sample_enterprise | datakeel.sample_timeseries | datakeel.evidence | datakeel.ontology | datakeel.actions | datakeel.catalog | datakeel.metrics | datakeel.ask | datakeel.workflows | datakeel.routing | datakeel.delegation | datakeel.memory
    datakeel.core
# Every same-layer dependency is explicit; new edges require a reviewed reason.
ignore_imports =
# Sensor inspection composes typed operators; scoring consumes their frozen measurements.
    datakeel.pipeline.tabular -> datakeel.operators.base
    datakeel.pipeline.tabular -> datakeel.operators.timeseries.models
    datakeel.quality.tabular -> datakeel.operators.table.models
    datakeel.quality.tabular -> datakeel.operators.timeseries.models
# Explicit memory services retain only typed projections across storage and tool boundaries.
    datakeel.memory.service -> datakeel.operators.text.pii_redact
    datakeel.memory.service -> datakeel.storage.memory_store
    datakeel.memory.service -> datakeel.storage.database
    datakeel.memory.tools -> datakeel.ontology.tool_models
    datakeel.memory.tools -> datakeel.storage.database
    datakeel.memory.tools -> datakeel.storage.tool_invocations
    datakeel.storage.memory_store -> datakeel.memory.consolidation
    datakeel.storage.memory_store -> datakeel.memory.retrieval
    datakeel.runtime.delegation_graph -> datakeel.agent.models
# Delegation validates tool policy and projects child conversations through typed stores.
    datakeel.delegation.loader -> datakeel.ontology.functions
    datakeel.delegation.models -> datakeel.ontology.tool_models
    datakeel.delegation.service -> datakeel.ontology.tool_models
    datakeel.delegation.service -> datakeel.storage.conversation_authorization
    datakeel.delegation.tree -> datakeel.storage.harness_service
    datakeel.delegation.tree -> datakeel.storage.tool_invocations
    datakeel.delegation.tree -> datakeel.storage.database
    datakeel.delegation.policy -> datakeel.storage.conversation_store
    datakeel.delegation.policy -> datakeel.storage.conversation_secrets
    datakeel.delegation.policy -> datakeel.storage.database
    datakeel.delegation.service -> datakeel.storage.tool_invocations
    datakeel.delegation.service -> datakeel.storage.conversation_store
    datakeel.delegation.service -> datakeel.storage.conversation_secrets
    datakeel.delegation.service -> datakeel.storage.database
    datakeel.delegation.tree -> datakeel.storage.conversation_store
    datakeel.delegation.service -> datakeel.actions.policy
    datakeel.delegation.loader -> datakeel.actions.registry
# Workflow definitions validate existing tool schemas and irreversible action policy.
    datakeel.workflows.schemas -> datakeel.actions.models
    datakeel.workflows.schemas -> datakeel.actions.parameters
    datakeel.workflows.schemas -> datakeel.evidence.query_models
    datakeel.workflows.schemas -> datakeel.ontology.functions
    datakeel.workflows.schemas -> datakeel.ontology.models
    datakeel.workflows.schemas -> datakeel.quality.models
    datakeel.workflows.validation -> datakeel.actions.registry
# Workflow adapters enter the persistent graph and reuse signed action receipts.
    datakeel.api.app -> datakeel.runtime.workflow_service
    datakeel.api.routes.workflow_runs -> datakeel.runtime.workflow_service
    datakeel.runtime.workflow_graph -> datakeel.agent.recovery
# Domain execution uses existing tool dispatch and read-only task projections.
    datakeel.workflows.execution -> datakeel.ontology.tool_models
    datakeel.workflows.execution -> datakeel.ontology.tooling
    datakeel.workflows.execution -> datakeel.storage.database
    datakeel.workflows.execution -> datakeel.storage.task_queries
# Recovery projects signed records into pure shared policy, independent of conversations.
    datakeel.storage.workflow_recovery -> datakeel.actions.recovery
    datakeel.storage.workflow_recovery -> datakeel.actions.models
    datakeel.storage.approval_evidence -> datakeel.actions.recovery
# Routing reads workflow vocabulary and controlled action declarations without dispatching them.
    datakeel.routing.classifier -> datakeel.workflows.models
    datakeel.routing.intent -> datakeel.workflows.models
    datakeel.routing.evaluation -> datakeel.workflows.loader
    datakeel.routing.service -> datakeel.workflows.loader
    datakeel.routing.service -> datakeel.workflows.models
    datakeel.routing.tiers -> datakeel.actions.registry
# Separate classification and model attempts use the same transactional budget and trace store.
    datakeel.routing.service -> datakeel.storage.database
    datakeel.routing.service -> datakeel.storage.harness_service
    datakeel.routing.accounting -> datakeel.storage.database
    datakeel.routing.accounting -> datakeel.storage.budget_service
    datakeel.routing.accounting -> datakeel.storage.harness_service
# HTTP exposes typed conversations/traces; application helpers meter calls for graph execution.
    datakeel.api.routes.agent -> datakeel.agent.service
    datakeel.api.routes.agent -> datakeel.agent.models
    datakeel.api.routes.harness -> datakeel.harness.service
    datakeel.harness.execution -> datakeel.agent.service
    datakeel.harness.execution -> datakeel.agent.providers
    datakeel.harness.execution -> datakeel.agent.models
# Conversation services enter the adapter; graph nodes reuse native guards, dispatch and metering.
    datakeel.agent.service -> datakeel.runtime.graph
    datakeel.agent.factory -> datakeel.runtime.chat_provider
    datakeel.runtime.graph -> datakeel.agent.dispatch
    datakeel.runtime.graph -> datakeel.agent.guards
    datakeel.runtime.graph -> datakeel.agent.metering
    datakeel.runtime.graph -> datakeel.agent.models
    datakeel.runtime.graph -> datakeel.agent.recovery
# Shared tool dispatch uses action policy/services and stores invocation audit through typed models.
    datakeel.ontology.tooling -> datakeel.actions.service
    datakeel.ontology.tooling -> datakeel.actions.models
    datakeel.ontology.tooling -> datakeel.actions.parameters
    datakeel.ontology.tooling -> datakeel.actions.policy
    datakeel.ontology.tooling -> datakeel.actions.references
    datakeel.ontology.tooling -> datakeel.storage.database
    datakeel.ontology.tooling -> datakeel.storage.tool_invocations
# Action facades call typed transactional storage services; schemas reuse ontology and DAG models.
    datakeel.actions.approvals -> datakeel.storage.action_approvals
    datakeel.actions.execution -> datakeel.storage.action_execution
    datakeel.actions.models -> datakeel.ontology.models
    datakeel.actions.parameters -> datakeel.ontology.models
    datakeel.actions.parameters -> datakeel.pipeline
    datakeel.actions.planning -> datakeel.storage.action_planning
    datakeel.actions.registry -> datakeel.ontology.models
    datakeel.actions.service -> datakeel.storage.action_store
    datakeel.actions.worker -> datakeel.storage.action_worker
# Read-only ontology functions use typed storage projections; object schemas reuse public views.
    datakeel.ontology.functions -> datakeel.storage.database
    datakeel.ontology.functions -> datakeel.storage.dataset_service
    datakeel.ontology.functions -> datakeel.storage.governance_service
    datakeel.ontology.functions -> datakeel.storage.lineage_service
    datakeel.ontology.functions -> datakeel.storage.object_queries
    datakeel.ontology.functions -> datakeel.storage.task_queries
    datakeel.ontology.properties -> datakeel.storage.views
    datakeel.ontology.tool_models -> datakeel.actions.models
# P1 persistence composes typed governance/quality/lineage projections; DAG validation uses operators.
    datakeel.governance.models -> datakeel.quality.models
    datakeel.lineage.service -> datakeel.storage.events
    datakeel.pipeline.execution -> datakeel.operators
    datakeel.pipeline.models -> datakeel.operators.base
    datakeel.pipeline.validation -> datakeel.operators
    datakeel.storage.datasets -> datakeel.semantic
    datakeel.storage.governance_service -> datakeel.governance
    datakeel.storage.governance_service -> datakeel.governance.models
    datakeel.storage.governance_service -> datakeel.quality
    datakeel.storage.governance_service -> datakeel.quality.models
    datakeel.storage.lineage_service -> datakeel.lineage.exports
    datakeel.storage.lineage_service -> datakeel.lineage.collapse
    datakeel.storage.lineage_service -> datakeel.lineage.models
    datakeel.storage.lineage_service -> datakeel.lineage.service
    datakeel.storage.task_queue -> datakeel.pipeline
    datakeel.storage.views -> datakeel.governance.models
# Persistence implements action transactions with pure policy/receipt helpers and ontology projections.
    datakeel.storage.action_approvals -> datakeel.actions.models
    datakeel.storage.action_execution -> datakeel.actions.models
    datakeel.storage.action_execution -> datakeel.actions.parameters
    datakeel.storage.action_execution -> datakeel.actions.policy
    datakeel.storage.action_execution -> datakeel.actions.receipts
    datakeel.storage.action_export -> datakeel.actions.models
    datakeel.storage.action_export -> datakeel.actions.parameters
    datakeel.storage.action_export -> datakeel.lineage.exports
    datakeel.storage.action_export -> datakeel.lineage.service
    datakeel.storage.action_operations -> datakeel.actions.models
    datakeel.storage.action_operations -> datakeel.actions.parameters
    datakeel.storage.action_operations -> datakeel.governance
    datakeel.storage.action_planning -> datakeel.actions.models
    datakeel.storage.action_planning -> datakeel.actions.parameters
    datakeel.storage.action_planning -> datakeel.actions.policy
    datakeel.storage.action_planning -> datakeel.actions.registry
    datakeel.storage.action_planning -> datakeel.actions.references
    datakeel.storage.action_planning -> datakeel.ontology.models
    datakeel.storage.action_planning -> datakeel.pipeline
    datakeel.storage.action_selection -> datakeel.actions.models
    datakeel.storage.action_selection -> datakeel.ontology.models
    datakeel.storage.action_snapshot -> datakeel.actions.models
    datakeel.storage.action_snapshot -> datakeel.actions.parameters
    datakeel.storage.action_snapshot -> datakeel.lineage.service
    datakeel.storage.action_snapshot -> datakeel.ontology.models
# Idempotent execution validates typed requests and the same canonical action policy.
    datakeel.storage.action_requests -> datakeel.actions.models
    datakeel.storage.action_requests -> datakeel.actions.policy
# Recovery verifies the original frozen action digest and signed actor before graph continuation.
    datakeel.storage.conversation_authorization -> datakeel.actions.models
    datakeel.storage.conversation_authorization -> datakeel.actions.recovery
    datakeel.storage.action_store -> datakeel.actions.models
    datakeel.storage.action_worker -> datakeel.actions.models
    datakeel.storage.action_worker -> datakeel.actions.receipts
    datakeel.storage.object_projection -> datakeel.ontology.models
    datakeel.storage.object_projection -> datakeel.quality
    datakeel.storage.object_queries -> datakeel.ontology.models
    datakeel.storage.tool_invocations -> datakeel.ontology.tool_models

# Evidence execution wraps the existing typed DAG and reads disposable storage caches.
    datakeel.evidence.execution -> datakeel.operators
    datakeel.evidence.execution -> datakeel.pipeline.models
    datakeel.evidence.execution -> datakeel.storage.database
    datakeel.evidence.execution -> datakeel.storage.evidence_cache
    datakeel.evidence.runtime_compute -> datakeel.operators
    datakeel.evidence.runtime_compute -> datakeel.pipeline.models
    datakeel.evidence.runtime_inputs -> datakeel.operators.evidence.contracts
    datakeel.evidence.runtime_inputs -> datakeel.storage.datasets
    datakeel.evidence.runtime_inputs -> datakeel.storage.objects
    datakeel.evidence.runtime_publication -> datakeel.pipeline.models
# Global-pair extraction requires one complete input shard at both submission boundaries.
    datakeel.storage.task_queue -> datakeel.pipeline.sharding
    datakeel.storage.action_planning -> datakeel.pipeline.sharding
    datakeel.storage.action_operations -> datakeel.pipeline.sharding
# The evidence preset binds each manifest to its independently versioned deterministic extractor.
    datakeel.pipeline.evidence -> datakeel.operators.evidence.annotation_labels
    datakeel.pipeline.evidence -> datakeel.operators.evidence.caption_mentions
    datakeel.pipeline.evidence -> datakeel.operators.evidence.image_phash
    datakeel.pipeline.evidence -> datakeel.operators.evidence.label_gap
    datakeel.pipeline.evidence -> datakeel.operators.evidence.near_duplicate
# Evidence tools share typed query models and read transactional evidence projections.
    datakeel.ontology.functions -> datakeel.evidence.query_models
    datakeel.ontology.evidence_functions -> datakeel.evidence.query_models
    datakeel.ontology.evidence_functions -> datakeel.storage.database
    datakeel.ontology.evidence_functions -> datakeel.storage.evidence_queries
# Assertion decisions reuse controlled plans and versioned asset selections in one transaction.
    datakeel.storage.evidence_actions -> datakeel.actions.models
    datakeel.storage.evidence_actions -> datakeel.actions.parameters
    datakeel.storage.evidence_actions -> datakeel.ontology.models
# Evidence queries extend ObjectSet and render typed frozen objects within storage snapshots.
    datakeel.evidence.query_models -> datakeel.ontology.models
    datakeel.evidence.presentation -> datakeel.ontology.models
    datakeel.storage.evidence_filters -> datakeel.ontology.models
    datakeel.storage.evidence_queries -> datakeel.ontology.models
    datakeel.storage.evidence_queries -> datakeel.evidence.query_models
    datakeel.storage.evidence_queries -> datakeel.evidence.presentation
# Evidence selection execution revalidates frozen file revisions without resampling assertions.
    datakeel.storage.action_targets -> datakeel.actions.models
    datakeel.storage.action_targets -> datakeel.actions.parameters
    datakeel.storage.action_targets -> datakeel.ontology.models
# Evidence golden fixtures exercise the existing fenced worker instead of fabricated assertions.
    datakeel.harness.evidence_cases -> datakeel.worker.runner
    datakeel.harness.injection_cases -> datakeel.worker.runner
# Evidence benchmarks evaluate typed ObjectSets against one consistent storage snapshot.
    datakeel.storage.evidence_evaluations -> datakeel.ontology.models
# Semantic persistence publishes typed metric snapshots using pure projection helpers.
    datakeel.storage.metric_store -> datakeel.metrics.projection
# Catalog import services publish typed snapshots through the transactional fact store.
    datakeel.catalog.importers.tabular -> datakeel.operators.table.models
    datakeel.catalog.importers.tabular -> datakeel.operators.table.profile
    datakeel.catalog.service -> datakeel.storage.catalog_store
    datakeel.catalog.service -> datakeel.storage.database
# Questions compose registered semantics and read-only compilation, then persist typed answers.
    datakeel.ask.service -> datakeel.storage.profile_queries
    datakeel.storage.profile_queries -> datakeel.operators.table.models
    datakeel.storage.profile_queries -> datakeel.operators.timeseries.models
    datakeel.ask.knowledge_service -> datakeel.storage.database
    datakeel.ask.knowledge_service -> datakeel.storage.link_queries
    datakeel.ask.service -> datakeel.metrics.compiler
    datakeel.ask.service -> datakeel.metrics.execution
    datakeel.ask.service -> datakeel.metrics.projection
    datakeel.ask.service -> datakeel.storage.ask_store
    datakeel.ask.service -> datakeel.storage.catalog_store
    datakeel.ask.service -> datakeel.storage.database
# Question recognition and answer assembly share one frozen current-graph read.
    datakeel.ask.service -> datakeel.storage.link_queries
# Catalog functions expose the same typed query and answer services to every tool transport.
    datakeel.ontology.catalog_functions -> datakeel.ask.service
    datakeel.ontology.catalog_functions -> datakeel.storage.metric_store
    datakeel.ontology.catalog_functions -> datakeel.storage.catalog_queries
    datakeel.ontology.catalog_functions -> datakeel.storage.database
# Metadata actions freeze independent catalog state and commit versioned semantics atomically.
    datakeel.storage.catalog_action_state -> datakeel.actions.catalog_parameters
    datakeel.storage.catalog_action_state -> datakeel.catalog.service
    datakeel.storage.catalog_action_state -> datakeel.ontology.models
    datakeel.storage.catalog_actions -> datakeel.actions.catalog_parameters
    datakeel.storage.catalog_actions -> datakeel.actions.models
    datakeel.storage.metric_audit -> datakeel.actions.models
    datakeel.storage.action_operations -> datakeel.actions.catalog_parameters
    datakeel.storage.action_snapshot -> datakeel.actions.catalog_parameters
    datakeel.storage.evidence_actions -> datakeel.actions.catalog_parameters
    datakeel.storage.term_changes -> datakeel.metrics.projection
# Current source availability refreshes semantic cards without rewriting historical versions.
    datakeel.storage.catalog_queries -> datakeel.metrics.projection
    datakeel.storage.ask_evidence -> datakeel.metrics.projection
# The offline question benchmark creates generated sources and exercises the production pipeline.
    datakeel.ask.evaluation -> datakeel.catalog.service
    datakeel.ask.evaluation -> datakeel.metrics.loader
    datakeel.ask.evaluation -> datakeel.sample_enterprise
    datakeel.ask.evaluation -> datakeel.storage.database
    datakeel.ask.evaluation -> datakeel.storage.metric_store
    datakeel.ask.evaluation_checks -> datakeel.metrics.sql_safety

# Scripted graph samples read only packaged vocabulary and recording fixtures.
    datakeel.sample_kg -> datakeel.kg.loader
# Graph extraction reuses controlled transactions and typed domain preparation/publication.
    datakeel.storage.action_planning -> datakeel.actions.kg_parameters
    datakeel.storage.action_operations -> datakeel.actions.kg_parameters
    datakeel.storage.kg_preparation -> datakeel.actions.kg_parameters
# Authorized workers reuse the same typed file-selection boundary for fingerprint verification.
    datakeel.storage.kg_inputs -> datakeel.actions.kg_parameters
    datakeel.storage.kg_preparation -> datakeel.actions.parameters
    datakeel.storage.kg_preparation -> datakeel.kg.loader
    datakeel.storage.kg_preparation -> datakeel.kg.policy
    datakeel.storage.kg_progress -> datakeel.kg.policy
    datakeel.storage.kg_preparation -> datakeel.kg.prompt
    datakeel.storage.kg_preparation -> datakeel.kg.text
    datakeel.storage.kg_pricing -> datakeel.kg.loader
    datakeel.storage.kg_publication -> datakeel.kg.aliases
    datakeel.storage.kg_publication -> datakeel.kg.cache
    datakeel.storage.kg_publication -> datakeel.kg.identity
    datakeel.storage.kg_publication -> datakeel.kg.retention
    datakeel.storage.kg_queries -> datakeel.kg.text
    datakeel.storage.kg_store -> datakeel.actions.kg_parameters
    datakeel.storage.kg_store -> datakeel.actions.models
# Graph read tools use typed storage projections; workers own the injected provider factory.
    datakeel.ontology.kg_functions -> datakeel.storage.database
    datakeel.ontology.kg_functions -> datakeel.storage.kg_queries
    datakeel.worker.kg_runner -> datakeel.extraction_runtime.factory
# Graph benchmarks drain the same durable worker path as user-triggered actions.
    datakeel.harness.kg_cases -> datakeel.worker.runner
    datakeel.harness.enterprise_kg -> datakeel.worker.runner
    datakeel.harness.execution -> datakeel.worker.runner

# Image preparation freezes typed provenance without invoking any model adapters.
    datakeel.storage.transcription_pricing -> datakeel.kg.policy
    datakeel.storage.kg_image_preparation -> datakeel.kg.prompt
    datakeel.storage.kg_image_preparation -> datakeel.transcription.loader
    datakeel.storage.kg_image_preparation -> datakeel.transcription.cache
    datakeel.storage.kg_image_preparation -> datakeel.transcription.images
    datakeel.storage.kg_image_preparation -> datakeel.transcription.prompt
    datakeel.storage.kg_inputs -> datakeel.transcription.images
    datakeel.storage.kg_inputs -> datakeel.transcription.loader
    datakeel.storage.kg_preparation -> datakeel.transcription.loader
    datakeel.storage.kg_image_sources -> datakeel.transcription.images
# UI replay recommendations compare frozen file hashes with validated recordings only.
    datakeel.storage.kg_transcription_selection -> datakeel.transcription.loader
# Successful transcript persistence enforces the same pure quality policy as execution.
    datakeel.storage.transcription_store -> datakeel.transcription.quality
    datakeel.evidence.kg_images -> datakeel.transcription.alignment
# Image evaluation persists the same product identities; offline goldens drain real worker tasks.
    datakeel.storage.kg_image_eval_store -> datakeel.kg.identity
    datakeel.harness.image_kg_cases -> datakeel.worker.runner

[importlinter:contract:runtime-framework-isolation]
name = Only runtime imports graph and chat-model frameworks
type = forbidden
source_modules =
    datakeel
forbidden_modules =
    langgraph
    langgraph_sdk
    langchain_core
    langchain_openai
    langchain_anthropic
    langsmith
    openai
    anthropic
    tiktoken
allow_indirect_imports = True
# The adapter owns framework edges; all other modules consume typed application interfaces.
ignore_imports =
    datakeel.runtime -> **
    datakeel.runtime.** -> **
    datakeel.extraction_runtime -> **
    datakeel.extraction_runtime.** -> **
# Some adapter entry points intentionally contain no imports.
unmatched_ignore_imports_alerting = none
